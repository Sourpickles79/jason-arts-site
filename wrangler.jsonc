{
  "name": "jason-arts-site",
  "compatibility_date": "2026-07-11",
  "main": "src/worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/feed.xml",
      "/sitemap.xml",
      "/blog-*",
      "/blog",
      "/blog.html",
      "/blog/",
      "/",
      "/index.html",
      "/portfolio",
      "/portfolio.html",
      "/portfolio/",
      "/books",
      "/books.html",
      "/books/",
      "/ai",
      "/ai.html",
      "/ai/",
      "/music",
      "/music.html",
      "/music/",
      "/cozy",
      "/cozy.html",
      "/cozy/",
      "/orb",
      "/orb.html",
      "/orb/"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BLOG_LIKES",
        "class_name": "BlogLikeCounter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-blog-likes",
      "new_sqlite_classes": [
        "BlogLikeCounter"
      ]
    }
  ]
}
